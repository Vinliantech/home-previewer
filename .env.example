SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
# Server-only. Bypasses RLS — never expose to the browser or prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Absolute origin of the deployed site, used in staff-invite links.
SITE_URL=https://kaystephgroup.com
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Configure only after the finance team verifies the production account.
VITE_INVESTMENT_BANK_NAME=
VITE_INVESTMENT_ACCOUNT_NAME=
VITE_INVESTMENT_ACCOUNT_NUMBER=

# Server-only Meta integration secrets. Never prefix these with VITE_.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_GRAPH_API_VERSION=
# Ad account id for campaign spend sync (with or without the act_ prefix).
# The token needs the ads_read permission. Optional: lead capture works without it.
META_AD_ACCOUNT_ID=

# Transactional CRM email. Keep the API key server-only.
RESEND_API_KEY=
CRM_EMAIL_FROM=Kay-Steph Group <enquiries@kaystephgroup.com>

# Brevo — workshop and event registration email. Server-only: the API key is a
# full-access credential (it can read every contact and send mail as the
# company), so never prefix any of these with VITE_ and never commit a real key.
BREVO_API_KEY=
# Numeric id of the Brevo contact list registrants are added to.
BREVO_LIST_ID=
# Numeric id of the transactional template used for the confirmation email.
# Its variables: FIRST_NAME, FULL_NAME, EMAIL, PHONE, LOCATION, GENDER,
# OCCUPATION, INTEREST, EVENT_NAME, REGISTRATION_REFERENCE.
BREVO_TEMPLATE_ID=
BREVO_SENDER_NAME=Kay-Steph Group
BREVO_SENDER_EMAIL=events@kaystephgroup.com
# Where the internal "new registration" notice is sent.
KAYSTEPH_ADMIN_EMAIL=

# Canonical domain used by sitemap and social metadata.
PUBLIC_SITE_URL=https://kaystephgroup.com

# Optional WhatsApp Business Cloud API connection.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
